{
  "buildCommand": "npm run build && node scripts/migrate-production.mjs",
  "outputDirectory": "dist/client",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/[...path]"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "dist/**"
    }
  }
}
